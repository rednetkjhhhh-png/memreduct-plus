MENU IDM_MAIN
FONT 8, "Ms Shell Dlg"
{
	CONTROL			"", IDC_LISTVIEW, WC_LISTVIEW, NOT WS_BORDER | LVS_SHOWSELALWAYS | LVS_REPORT | LVS_NOCOLUMNHEADER, 8, 8, 208, 174

	PUSHBUTTON		"", IDC_CLEAN, 8, 192, 208, 14, BS_SPLITBUTTON | BS_CENTER | BS_VCENTER
}

